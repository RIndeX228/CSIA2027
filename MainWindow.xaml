<Window x:Class="CS_IA_2027.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:tb="http://www.hardcodet.net/taskbar"

		Title="Widget"
		Width="280"
		SizeToContent="Height"
		Left="60" Top="60"
		WindowStartupLocation="Manual"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="False"
		Topmost="True"
		ResizeMode="NoResize"
		Loaded="Window_Loaded">

	<Window.Resources>
		<ContextMenu x:Key="TrayMenu">
			<MenuItem Header="Refresh widgets" Click="RefreshWidgets_Click" />
			<MenuItem Header="Open config" Click="OpenConfig_Click" />
			<Separator />
			<MenuItem Header="Show/Hide panel" Click="ToggleVisibility_Click" />
			<MenuItem Header="Exit" Click="Exit_Click" />
		</ContextMenu>
	</Window.Resources>

	<!-- Brushes here are DynamicResource on purpose: config.json swaps them
		 out at runtime, and StaticResource would ignore the swap.
		 Elements with Style EditOnly / ViewOnly only show in the edit state /
		 the normal state (see Theme.xaml). -->
	<Grid Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
		<StackPanel Margin="8">

			<!-- Top bar: the pencil normally, the two save buttons while editing -->
			<Grid Margin="0,0,0,8">
				<StackPanel Style="{StaticResource ViewOnly}" HorizontalAlignment="Right">
					<Button Style="{StaticResource PillButton}" Click="Edit_Click" ToolTip="Edit widgets"
							FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Content="&#xE70F;" />
				</StackPanel>
				<StackPanel Style="{StaticResource EditOnly}" Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Style="{StaticResource PillButton}" Content="Save" Click="Save_Click" />
				</StackPanel>
			</Grid>

			<StackPanel x:Name="CardStack">

				<!-- Weather -->
				<Border x:Name="WeatherCard"
						Background="{DynamicResource WeatherCardBackground}"
						CornerRadius="16" Padding="16,14" Margin="0,0,0,8">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- order arrows -->
						<StackPanel Grid.Column="0" Style="{StaticResource EditOnly}" VerticalAlignment="Center" Margin="0,0,8,0">
							<Button Content="&#x25B2;" Tag="weather" Click="MoveUp_Click" Style="{StaticResource FlatButton}" />
							<Button Content="&#x25BC;" Tag="weather" Click="MoveDown_Click" Style="{StaticResource FlatButton}" />
						</StackPanel>

						<StackPanel Grid.Column="1">
							<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
								<Ellipse Width="10" Height="10" Fill="{DynamicResource WeatherAccentBrush}"
										 VerticalAlignment="Center" />
								<TextBlock Text="Weather" Foreground="{DynamicResource WeatherAccentBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
										   Margin="8,0,0,0" VerticalAlignment="Center" />
							</StackPanel>

							<!-- normal state -->
							<StackPanel Style="{StaticResource ViewOnly}">
								<TextBlock x:Name="WeatherDataText" Text="…" Foreground="{DynamicResource WeatherAccentBrush}"
										   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
								<TextBlock x:Name="WeatherSecondaryText" Text="Loading" Foreground="{DynamicResource WeatherSecondaryBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
							</StackPanel>

							<!-- edit state -->
							<StackPanel Style="{StaticResource EditOnly}">
								<StackPanel Orientation="Horizontal">
									<ToggleButton x:Name="WeatherEnabledSwitch" Style="{StaticResource SwitchToggle}"
												  Foreground="{DynamicResource WeatherAccentBrush}" />
									<TextBox x:Name="WeatherColourBox" Style="{StaticResource EditBox}"
											 Width="84" Margin="12,0,0,0" ToolTip="Primary colour as #RRGGBB" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<TextBlock Text="Update every" Style="{StaticResource EditCaption}" Margin="0,0,8,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource WeatherSecondaryBrush}" />
									<TextBox x:Name="WeatherRateBox" Style="{StaticResource EditBox}" Width="56"
											 ToolTip="Seconds between updates (5 to 86400)" />
									<TextBlock Text="seconds" Style="{StaticResource EditCaption}" Margin="8,0,0,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource WeatherSecondaryBrush}" />
								</StackPanel>
								<TextBlock Text="City, or lat, lon" Style="{StaticResource EditCaption}"
										   Foreground="{DynamicResource WeatherSecondaryBrush}" />
								<TextBox x:Name="WeatherSettingsBox" Style="{StaticResource EditBox}" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<!-- GitHub -->
				<Border x:Name="GitHubCard"
						Background="{DynamicResource GitHubCardBackground}"
						CornerRadius="16" Padding="16,14" Margin="0,0,0,8">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- order arrows -->
						<StackPanel Grid.Column="0" Style="{StaticResource EditOnly}" VerticalAlignment="Center" Margin="0,0,8,0">
							<Button Content="&#x25B2;" Tag="github" Click="MoveUp_Click" Style="{StaticResource FlatButton}" />
							<Button Content="&#x25BC;" Tag="github" Click="MoveDown_Click" Style="{StaticResource FlatButton}" />
						</StackPanel>

						<StackPanel Grid.Column="1">
							<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
								<Grid Width="10" Height="10" VerticalAlignment="Center">
									<Ellipse Width="10" Height="10" Stroke="{DynamicResource GitHubAccentBrush}" StrokeThickness="1.5" />
									<Ellipse Width="4" Height="4" Fill="{DynamicResource GitHubAccentBrush}"
											 HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Grid>
								<TextBlock Text="GitHub" Foreground="{DynamicResource GitHubAccentBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
										   Margin="8,0,0,0" VerticalAlignment="Center" />
							</StackPanel>

							<!-- normal state -->
							<StackPanel Style="{StaticResource ViewOnly}">
								<TextBlock x:Name="GitHubDataText" Text="…" Foreground="{DynamicResource GitHubAccentBrush}"
										   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
								<TextBlock x:Name="GitHubSecondaryText" Text="Loading" Foreground="{DynamicResource GitHubSecondaryBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
							</StackPanel>

							<!-- edit state (no settings box, GitHub only needs the token from the environment) -->
							<StackPanel Style="{StaticResource EditOnly}">
								<StackPanel Orientation="Horizontal">
									<ToggleButton x:Name="GitHubEnabledSwitch" Style="{StaticResource SwitchToggle}"
												  Foreground="{DynamicResource GitHubAccentBrush}" />
									<TextBox x:Name="GitHubColourBox" Style="{StaticResource EditBox}"
											 Width="84" Margin="12,0,0,0" ToolTip="Primary colour as #RRGGBB" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<TextBlock Text="Update every" Style="{StaticResource EditCaption}" Margin="0,0,8,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource GitHubSecondaryBrush}" />
									<TextBox x:Name="GitHubRateBox" Style="{StaticResource EditBox}" Width="56"
											 ToolTip="Seconds between updates (5 to 86400)" />
									<TextBlock Text="seconds" Style="{StaticResource EditCaption}" Margin="8,0,0,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource GitHubSecondaryBrush}" />
								</StackPanel>
								<TextBlock Text="No extra settings" Style="{StaticResource EditCaption}"
										   Foreground="{DynamicResource GitHubSecondaryBrush}" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<!-- Stocks -->
				<Border x:Name="StockCard"
						Background="{DynamicResource StockCardBackground}"
						CornerRadius="16" Padding="16,14" Margin="0,0,0,8">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- order arrows -->
						<StackPanel Grid.Column="0" Style="{StaticResource EditOnly}" VerticalAlignment="Center" Margin="0,0,8,0">
							<Button Content="&#x25B2;" Tag="stocks" Click="MoveUp_Click" Style="{StaticResource FlatButton}" />
							<Button Content="&#x25BC;" Tag="stocks" Click="MoveDown_Click" Style="{StaticResource FlatButton}" />
						</StackPanel>

						<StackPanel Grid.Column="1">
							<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
								<Grid Width="16" Height="12" VerticalAlignment="Center">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Rectangle Grid.Column="0" Width="3" Height="5" Fill="{DynamicResource StockAccentBrush}" VerticalAlignment="Bottom" />
									<Rectangle Grid.Column="1" Width="3" Height="8" Fill="{DynamicResource StockAccentBrush}" VerticalAlignment="Bottom" />
									<Rectangle Grid.Column="2" Width="3" Height="12" Fill="{DynamicResource StockAccentBrush}" VerticalAlignment="Bottom" />
								</Grid>
								<TextBlock Text="Stocks" Foreground="{DynamicResource StockAccentBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
										   Margin="8,0,0,0" VerticalAlignment="Center" />
							</StackPanel>

							<!-- normal state -->
							<StackPanel Style="{StaticResource ViewOnly}">
								<TextBlock x:Name="StockDataText" Text="…" Foreground="{DynamicResource StockAccentBrush}"
										   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
								<TextBlock x:Name="StockSecondaryText" Text="Loading" Foreground="{DynamicResource StockSecondaryBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
							</StackPanel>

							<!-- edit state -->
							<StackPanel Style="{StaticResource EditOnly}">
								<StackPanel Orientation="Horizontal">
									<ToggleButton x:Name="StockEnabledSwitch" Style="{StaticResource SwitchToggle}"
												  Foreground="{DynamicResource StockAccentBrush}" />
									<TextBox x:Name="StockColourBox" Style="{StaticResource EditBox}"
											 Width="84" Margin="12,0,0,0" ToolTip="Primary colour as #RRGGBB" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<TextBlock Text="Update every" Style="{StaticResource EditCaption}" Margin="0,0,8,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource StockSecondaryBrush}" />
									<TextBox x:Name="StockRateBox" Style="{StaticResource EditBox}" Width="56"
											 ToolTip="Seconds between updates (5 to 86400)" />
									<TextBlock Text="seconds" Style="{StaticResource EditCaption}" Margin="8,0,0,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource StockSecondaryBrush}" />
								</StackPanel>
								<TextBlock Text="Symbols, comma separated" Style="{StaticResource EditCaption}"
										   Foreground="{DynamicResource StockSecondaryBrush}" />
								<TextBox x:Name="StockSettingsBox" Style="{StaticResource EditBox}" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

				<!-- News -->
				<Border x:Name="NewsCard"
						Background="{DynamicResource NewsCardBackground}"
						CornerRadius="16" Padding="16,14">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<!-- order arrows -->
						<StackPanel Grid.Column="0" Style="{StaticResource EditOnly}" VerticalAlignment="Center" Margin="0,0,8,0">
							<Button Content="&#x25B2;" Tag="news" Click="MoveUp_Click" Style="{StaticResource FlatButton}" />
							<Button Content="&#x25BC;" Tag="news" Click="MoveDown_Click" Style="{StaticResource FlatButton}" />
						</StackPanel>

						<StackPanel Grid.Column="1">
							<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
								<Grid Width="14" Height="10" VerticalAlignment="Center">
									<StackPanel VerticalAlignment="Center">
										<Rectangle Width="14" Height="2" Fill="{DynamicResource NewsAccentBrush}" Margin="0,0,0,2" RadiusX="1" RadiusY="1" />
										<Rectangle Width="10" Height="2" Fill="{DynamicResource NewsAccentBrush}" Margin="0,0,0,2" RadiusX="1" RadiusY="1" />
										<Rectangle Width="6" Height="2" Fill="{DynamicResource NewsAccentBrush}" RadiusX="1" RadiusY="1" />
									</StackPanel>
								</Grid>
								<TextBlock Text="News" Foreground="{DynamicResource NewsAccentBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
										   Margin="8,0,0,0" VerticalAlignment="Center" />
							</StackPanel>

							<!-- normal state -->
							<StackPanel Style="{StaticResource ViewOnly}">
								<TextBlock x:Name="NewsDataText" Text="…" Foreground="{DynamicResource NewsAccentBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold"
										   TextWrapping="Wrap" />
								<TextBlock x:Name="NewsSecondaryText" Text="Loading" Foreground="{DynamicResource NewsSecondaryBrush}"
										   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
							</StackPanel>

							<!-- edit state -->
							<StackPanel Style="{StaticResource EditOnly}">
								<StackPanel Orientation="Horizontal">
									<ToggleButton x:Name="NewsEnabledSwitch" Style="{StaticResource SwitchToggle}"
												  Foreground="{DynamicResource NewsAccentBrush}" />
									<TextBox x:Name="NewsColourBox" Style="{StaticResource EditBox}"
											 Width="84" Margin="12,0,0,0" ToolTip="Primary colour as #RRGGBB" />
								</StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<TextBlock Text="Update every" Style="{StaticResource EditCaption}" Margin="0,0,8,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource NewsSecondaryBrush}" />
									<TextBox x:Name="NewsRateBox" Style="{StaticResource EditBox}" Width="56"
											 ToolTip="Seconds between updates (5 to 86400)" />
									<TextBlock Text="seconds" Style="{StaticResource EditCaption}" Margin="8,0,0,0"
											   VerticalAlignment="Center" Foreground="{DynamicResource NewsSecondaryBrush}" />
								</StackPanel>
								<TextBlock Text="RSS feed URL" Style="{StaticResource EditCaption}"
										   Foreground="{DynamicResource NewsSecondaryBrush}" />
								<TextBox x:Name="NewsSettingsBox" Style="{StaticResource EditBox}" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>

			</StackPanel>
		</StackPanel>

		<tb:TaskbarIcon x:Name="TrayIcon"
						 ToolTipText="My Desktop Widget"
						 ContextMenu="{StaticResource TrayMenu}">
			<tb:TaskbarIcon.IconSource>
				<tb:GeneratedIconSource Text="W" Background="#1E88E5"
										 Foreground="White" FontWeight="Bold" />
			</tb:TaskbarIcon.IconSource>
		</tb:TaskbarIcon>
	</Grid>
</Window>
