<Window x:Class="CS_IA_2027.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:tb="http://www.hardcodet.net/taskbar"
		
		Title="Widget"
		Width="280"
		SizeToContent="Height"
		Left="60" Top="60"
		WindowStartupLocation="Manual"
		WindowStyle="None"
		AllowsTransparency="True"
		Background="Transparent"
		ShowInTaskbar="False"
		Topmost="True"
		ResizeMode="NoResize"
		Loaded="Window_Loaded">

	<Window.Resources>
		<ContextMenu x:Key="TrayMenu">
			<MenuItem Header="Refresh widgets" Click="RefreshWidgets_Click" />
			<Separator />
			<MenuItem Header="Show/Hide panel" Click="ToggleVisibility_Click" />
			<Separator />
			<MenuItem Header="Open config" Click="OpenConfig_Click" />
			<MenuItem Header="Exit" Click="Exit_Click" />
			
		</ContextMenu>

		
	</Window.Resources>
	
	<Grid Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
		<StackPanel x:Name="CardStack" Margin="8">

			<!-- Weather -->
			<Border x:Name="WeatherCard" Background="{DynamicResource WeatherCardBackground}"
					CornerRadius="16" Padding="16,14" Margin="0,0,0,8"
					>
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<Ellipse Width="10" Height="10" Fill="{DynamicResource WeatherAccentBrush}"
								 VerticalAlignment="Center" />
						<TextBlock Text="Weather" Foreground="{DynamicResource WeatherAccentBrush}"
								   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
								   Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock x:Name="WeatherDataText" Text="…" Foreground="{DynamicResource WeatherAccentBrush}"
							   FontFamily="Consolas" FontSize="26" FontWeight="Bold" />
					<TextBlock x:Name="WeatherSecondaryText" Text="Loading" Foreground="{StaticResource TextSecondaryBrush}"
							   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<!-- GitHub -->
			<Border x:Name="GitHubCard" Background="{DynamicResource GitHubCardBackground}"
					CornerRadius="16" Padding="16,14" Margin="0,0,0,8"
					>
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<Grid Width="10" Height="10" VerticalAlignment="Center">
							<Ellipse Width="10" Height="10" Stroke="{DynamicResource GitHubAccentBrush}" StrokeThickness="1.5" />
							<Ellipse Width="4" Height="4" Fill="{DynamicResource GitHubAccentBrush}"
									 HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Grid>
						<TextBlock Text="GitHub" Foreground="{DynamicResource GitHubAccentBrush}"
								   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
								   Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock x:Name="GitHubDataText" Text="…" Foreground="{DynamicResource GitHubAccentBrush}"
							   FontFamily="Consolas" FontSize="26" FontWeight="Bold" />
					<TextBlock x:Name="GitHubSecondaryText" Text="Loading" Foreground="{StaticResource TextSecondaryBrush}"
							   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<!-- Stocks -->
			<Border x:Name="StockCard" Background="{DynamicResource StockCardBackground}"
					CornerRadius="16" Padding="16,14" Margin="0,0,0,8"
					>
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<Grid Width="16" Height="12" VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Rectangle Grid.Column="0" Width="3" Height="5" Fill="{DynamicResource StockAccentBrush}" VerticalAlignment="Bottom" />
							<Rectangle Grid.Column="1" Width="3" Height="8" Fill="{DynamicResource StockAccentBrush}" VerticalAlignment="Bottom" />
							<Rectangle Grid.Column="2" Width="3" Height="12" Fill="{DynamicResource StockAccentBrush}" VerticalAlignment="Bottom" />
						</Grid>
						<TextBlock Text="Stocks" Foreground="{DynamicResource StockAccentBrush}"
								   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
								   Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock x:Name="StockDataText" Text="…" Foreground="{DynamicResource StockAccentBrush}"
							   FontFamily="Consolas" FontSize="26" FontWeight="Bold" />
					<TextBlock x:Name="StockSecondaryText" Text="Loading" Foreground="{StaticResource TextSecondaryBrush}"
							   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
				</StackPanel>
			</Border>
			<Border x:Name="NewsCard" Background="{DynamicResource NewsCardBackground}"
		CornerRadius="16" Padding="16,14"
		>
				<StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
						<Grid Width="14" Height="10" VerticalAlignment="Center">
							<StackPanel VerticalAlignment="Center">
								<Rectangle Width="14" Height="2" Fill="{DynamicResource NewsAccentBrush}" Margin="0,0,0,2" RadiusX="1" RadiusY="1" />
								<Rectangle Width="10" Height="2" Fill="{DynamicResource NewsAccentBrush}" Margin="0,0,0,2" RadiusX="1" RadiusY="1" />
								<Rectangle Width="6" Height="2" Fill="{DynamicResource NewsAccentBrush}" RadiusX="1" RadiusY="1" />
							</StackPanel>
						</Grid>
						<TextBlock Text="News" Foreground="{DynamicResource NewsAccentBrush}"
					   FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" FontWeight="SemiBold"
					   Margin="8,0,0,0" VerticalAlignment="Center" />
					</StackPanel>
					<TextBlock x:Name="NewsDataText" Text="…" Foreground="{DynamicResource NewsAccentBrush}"
				   FontFamily="Segoe UI Variable, Segoe UI" FontSize="15" FontWeight="SemiBold"
				   TextWrapping="Wrap" />
					<TextBlock x:Name="NewsSecondaryText" Text="Loading" Foreground="{StaticResource TextSecondaryBrush}"
				   FontFamily="Segoe UI Variable, Segoe UI" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

		</StackPanel>
		

		<!-- The tray icon is the only thing the user sees outside this
			 overlay. GeneratedIconSource builds the icon from text/shapes
			 in XAML, so no external .ico asset is required. -->
		<tb:TaskbarIcon x:Name="TrayIcon"
						 ToolTipText="My Desktop Widget"
						 ContextMenu="{StaticResource TrayMenu}">
			<tb:TaskbarIcon.IconSource>
				<tb:GeneratedIconSource Text="W" Background="#1E88E5"
										 Foreground="White" FontWeight="Bold" />
			</tb:TaskbarIcon.IconSource>
		</tb:TaskbarIcon>
	</Grid>
</Window>
