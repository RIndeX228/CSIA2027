<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Base palette (DSGN.HOUSE reference) -->
	<Color x:Key="VoidBlack">#06070A</Color>
	<Color x:Key="ElectricCobalt">#3D5AFE</Color>
	<Color x:Key="SynthMagenta">#FF2FA3</Color>
	<Color x:Key="ToxicAmber">#FF8A1E</Color>
	<Color x:Key="TitaniumFog">#AEB6C2</Color>
	<Color x:Key="HolographicPearl">#F5F7FF</Color>
	<Color x:Key="SignalCyan">#22D3EE</Color>
	<!-- Holographic Pearl is intentionally unused below - reserved for a
		 future widget or UI chrome (see README). -->

	<!-- Shared text -->
	<SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TitaniumFog}" />

	<!-- Per-widget accents -->
	<SolidColorBrush x:Key="NewsAccentBrush" Color="{StaticResource SignalCyan}" />
	<SolidColorBrush x:Key="WeatherAccentBrush" Color="{StaticResource ElectricCobalt}" />
	<SolidColorBrush x:Key="GitHubAccentBrush" Color="{StaticResource SynthMagenta}" />
	<SolidColorBrush x:Key="StockAccentBrush" Color="{StaticResource ToxicAmber}" />

	<!-- Per-widget card backgrounds: Void Black toward a ~20% tint of the
		 widget's own accent. Kept dark and muted on purpose. -->
	<LinearGradientBrush x:Key="WeatherCardBackground" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="{StaticResource VoidBlack}" Offset="0" />
		<GradientStop Color="#121940" Offset="1" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="GitHubCardBackground" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="{StaticResource VoidBlack}" Offset="0" />
		<GradientStop Color="#3D102C" Offset="1" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="StockCardBackground" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="{StaticResource VoidBlack}" Offset="0" />
		<GradientStop Color="#3D240E" Offset="1" />
	</LinearGradientBrush>
	<LinearGradientBrush x:Key="NewsCardBackground" StartPoint="0,0" EndPoint="1,1">
		<GradientStop Color="{StaticResource VoidBlack}" Offset="0" />
		<GradientStop Color="#0C343C" Offset="1" />
	</LinearGradientBrush>

</ResourceDictionary>